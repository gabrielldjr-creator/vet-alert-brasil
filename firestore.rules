rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /vetProfiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /doctors/{doctorUid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == doctorUid;
      allow delete: if false;
    }
    // V2 is server-only. These rules are additive and do not change legacy access.
    match /veterinaryObservationsV2/{documentId} {
      allow get, list, create, update, delete: if false;
    }
    match /submissionIntegrityV2/{documentId} {
      allow get, list, create, update, delete: if false;
    }
    match /auditLogsV2/{documentId} {
      allow get, list, create, update, delete: if false;
    }
  }
}
